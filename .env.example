# =============================================================================
#  marketplace — environment template
#  Copy to .env and adjust:   cp .env.example .env
#  Docker Compose reads this file automatically (see Makefile: COMPOSE).
# =============================================================================

# ------------------------------------------------------------------ runtime
APP_ENV=dev                      # dev | staging | prod
LOG_LEVEL=info                   # debug | info | warn | error
LOG_FORMAT=json                  # json (prod) | text (local)

# ----------------------------------------------------------------- postgres
# One logical database per service — no cross-service table access, ever.
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=marketplace
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

AUTH_DB_NAME=auth_db
CATALOG_DB_NAME=catalog_db
INVENTORY_DB_NAME=inventory_db
ORDER_DB_NAME=order_db
PAYMENT_DB_NAME=payment_db
NOTIFICATION_DB_NAME=notification_db

# ------------------------------------------------------------------- redis
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# ------------------------------------------------------------------- kafka
# 9092 is the in-network listener the services use. 29092 is published on the
# host for tools such as kcat; it is not the address services should dial.
KAFKA_BROKERS=kafka:9092
KAFKA_TOPIC_PREFIX=marketplace
KAFKA_CONSUMER_GROUP_SUFFIX=v1

# ------------------------------------------------------ gRPC listen addrs
# Internal to the compose network; only the gateway is exposed to the host.
AUTH_GRPC_ADDR=:9091
CATALOG_GRPC_ADDR=:9092
INVENTORY_GRPC_ADDR=:9093
ORDER_GRPC_ADDR=:9094
PAYMENT_GRPC_ADDR=:9095

# ------------------------------------------------- readiness probe addrs
# Each service serves /healthz, /readyz, /version and /metrics on one port.
# Prometheus scrapes exactly these (see deploy/prometheus/prometheus.yml).
GATEWAY_HEALTH_ADDR=:9180
AUTH_HEALTH_ADDR=:9191
CATALOG_HEALTH_ADDR=:9192
INVENTORY_HEALTH_ADDR=:9193
ORDER_HEALTH_ADDR=:9194
PAYMENT_HEALTH_ADDR=:9195
NOTIFICATION_HEALTH_ADDR=:9196

# ------------------------------------------------- gRPC client targets
AUTH_GRPC_TARGET=auth:9091
CATALOG_GRPC_TARGET=catalog:9092
INVENTORY_GRPC_TARGET=inventory:9093
ORDER_GRPC_TARGET=order:9094
PAYMENT_GRPC_TARGET=payment:9095

# ----------------------------------------------------------------- gateway
GATEWAY_HTTP_ADDR=:8080
JWT_SECRET=change-me-in-production-please-use-32-bytes-min
JWT_ISSUER=marketplace
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
RATE_LIMIT_RPS=50
RATE_LIMIT_BURST=100
GATEWAY_REQUEST_TIMEOUT=5s

# ------------------------------------------------------------------- saga
SAGA_MAX_ATTEMPTS=5
SAGA_STEP_TIMEOUT=3s
SAGA_RECOVERY_INTERVAL=30s          # how often the recovery worker polls for stuck sagas
SAGA_STUCK_AFTER=2m                 # a saga older than this is considered stuck

# ----------------------------------------------------------- resilience
RESILIENCE_RETRY_MAX_ATTEMPTS=4
RESILIENCE_RETRY_BASE_DELAY=50ms
RESILIENCE_RETRY_MAX_DELAY=2s
RESILIENCE_CIRCUIT_BREAKER_THRESHOLD=5
RESILIENCE_CIRCUIT_BREAKER_TIMEOUT=30s

# ------------------------------------------------------------------ outbox
OUTBOX_POLL_INTERVAL=1s
OUTBOX_BATCH_SIZE=100
OUTBOX_MAX_ATTEMPTS=10

# ------------------------------------------------- payment (simulation)
# Intentionally non-zero in dev so the saga rollback path is exercised.
PAYMENT_FAILURE_RATE=0.15
PAYMENT_LATENCY_MS=50

# ----------------------------------------------------------- observability
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=jaeger:4317
OTEL_TRACES_SAMPLER_RATIO=1.0
OTEL_METRICS_ENABLED=true
PROMETHEUS_ADDR=:9100

# ------------------------------------------------------- host port mapping
# Only these are published on the host machine.
GATEWAY_HOST_PORT=8080
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
KAFKA_HOST_PORT=29092
JAEGER_UI_HOST_PORT=16686
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
